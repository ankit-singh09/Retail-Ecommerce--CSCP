    "raw_rows = len(df_raw)\n",
    "dedup_df = df_raw.drop_duplicates()\n",
    "dropped_dups = raw_rows - len(dedup_df)\n",
    "\n",
    "# Simulate removing non-commercial Price <= 0 entries after deduplication\n",
    "clean_sim = dedup_df[dedup_df['Price'] > 0]\n",
    "dropped_bad_price = len(dedup_df) - len(clean_sim)\n",
    "\n",
    "total_dropped = raw_rows - len(clean_sim)\n",
    "retained_pct = (len(clean_sim) / raw_rows) * 100\n",
    "\n",
    "summary_impact = pd.DataFrame([\n",
    "    {'Step': 'Raw Dataset Baseline', 'Rows_Removed': 0, 'Remaining_Rows': raw_rows, 'Pct_of_Raw': 100.00},\n",
    "    {'Step': '1. Drop Exact Duplicates', 'Rows_Removed': dropped_dups, 'Remaining_Rows': len(dedup_df), 'Pct_of_Raw': len(dedup_df)/raw_rows*100},\n",
    "    {'Step': '2. Drop Price <= 0 (Adjustments/Errors)', 'Rows_Removed': dropped_bad_price, 'Remaining_Rows': len(clean_sim), 'Pct_of_Raw': retained_pct}\n",
    "])\n",
    "display(summary_impact)\n",
    "print(f\"Total Rows Dropped: {total_dropped:,} ({100 - retained_pct:.2f}%) | Retained: {len(clean_sim):,} ({retained_pct:.2f}%)\")"
