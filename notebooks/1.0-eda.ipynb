        "outputId": "c55ffcf7-27b8-4560-f654-3f13c28949aa"
      },
      "source": [
        "# Show top 10 transactions with the largest absolute quantity\n",
        "top_qty = df.iloc[df['Quantity'].abs().nlargest(10).index]\n",
