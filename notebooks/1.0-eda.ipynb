   "source": [
    "missing_count = df_raw.isnull().sum()\n",
    "missing_df = pd.DataFrame({\n",
    "    'Missing_Count': missing_count,\n",
    "    'Missing_Pct': (missing_count / len(df_raw)) * 100,\n",
    "    'Dtype': df_raw.dtypes\n",
    "}).sort_values(by='Missing_Count', ascending=False)\n",
    "display(missing_df)\n",
    "\n",
    "# Evaluate commercial value inside missing Customer ID rows\n",
    "gross_mask = (df_raw['Quantity'] > 0) & (df_raw['Price'] > 0)\n",
    "guest_mask = df_raw['Customer ID'].isna()\n",
    "total_gross_rev = (df_raw.loc[gross_mask, 'Quantity'] * df_raw.loc[gross_mask, 'Price']).sum()\n",
    "guest_gross_rev = (df_raw.loc[gross_mask & guest_mask, 'Quantity'] * df_raw.loc[gross_mask & guest_mask, 'Price']).sum()\n",
    "\n",
    "print(f\"Guest rows with positive Qty & Price: {(gross_mask & guest_mask).sum():,} of {guest_mask.sum():,}\")\n",
    "print(f\"Total Gross Revenue (Qty>0, Price>0): \u00a3{total_gross_rev:,.2f}\")\n",
    "print(f\"Guest Gross Revenue:                  \u00a3{guest_gross_rev:,.2f} ({guest_gross_rev/total_gross_rev*100:.2f}%)\")\n",
    "\n",
    "# Visualize missingness and revenue share\n",
    "fig, axes = plt.subplots(1, 2, figsize=(11, 3.8))\n",
    "\n",
    "miss_nonzero = missing_df[missing_df['Missing_Count'] > 0]\n",
    "sns.barplot(x=miss_nonzero['Missing_Pct'], y=miss_nonzero.index, ax=axes[0], color='#4C72B0')\n",
    "axes[0].set_title('Missing Value Percentage by Column')\n",
    "axes[0].set_xlabel('Missing (%)')\n",
    "for i, v in enumerate(miss_nonzero['Missing_Pct']):\n",
    "    axes[0].text(v + 0.4, i, f\"{v:.2f}%\", va='center')\n",
    "axes[0].set_xlim(0, 28)\n",
    "\n",
    "rev_labels = ['Registered Customers', 'Unregistered (Null Customer ID)']\n",
    "rev_vals = [total_gross_rev - guest_gross_rev, guest_gross_rev]\n",
    "axes[1].pie(rev_vals, labels=rev_labels, autopct='%1.2f%%', startangle=90, colors=['#55A868', '#DD8452'])\n",
    "axes[1].set_title('Gross Revenue Share (Qty > 0, Price > 0)')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
