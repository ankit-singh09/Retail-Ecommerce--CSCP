        "id": "c9dd30c5"
      },
      "source": [
        "### **Q1: Which countries have the highest number of unidentified customers?**"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "collapsed": true,
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 394
