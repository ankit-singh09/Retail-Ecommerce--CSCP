      "source": [
        "### **3. Transaction Frequency per Customer (Concentration Risk)**\n",
        "To understand customer behavior, we need to inspect the purchasing power distribution. Do a few customers dominate the dataset, or is revenue evenly distributed?"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 677
        },
        "id": "94e8311a",
        "outputId": "d1e31888-6ecf-4764-f24c-8dec963577d2"
      },
      "source": [
        "# Analyze purchase frequency by unique customers (excluding missing values)\n",
        "customer_volume = df[df['Customer ID'].notna()]['Customer ID'].value_counts().reset_index()\n",
        "customer_volume.columns = ['Customer ID', 'Transaction_Count']\n",
        "\n",
        "print(\"--- CUSTOMER TRANSACTION CONCENTRATION ---\")\n",
        "print(customer_volume['Transaction_Count'].describe())\n",
        "\n",
        "# Visualizing the distribution of transactions per customer (Log Scale to handle long tails)\n",
        "plt.figure(figsize=(10, 5))\n",
        "sns.histplot(customer_volume['Transaction_Count'], bins=50, kde=True, log_scale=True, color='purple')\n",
        "plt.title('Distribution of Transaction Volume per Customer (Log Scale)')\n",
        "plt.xlabel('Number of Transactions')\n",
        "plt.ylabel('Count of Customers')\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "plt.show()"
      ],
      "execution_count": 39,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "--- CUSTOMER TRANSACTION CONCENTRATION ---\n",
            "count       4265.0\n",
            "mean     90.638453\n",
            "std      194.72442\n",
            "min            1.0\n",
            "25%           18.0\n",
            "50%           43.0\n",
            "75%           97.0\n",
            "max         5496.0\n",
            "Name: Transaction_Count, dtype: Float64\n"
          ]
        },
