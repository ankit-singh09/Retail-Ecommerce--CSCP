    "valid_cust = df_raw['Customer ID'].dropna()\n",
    "cust_countries = df_raw.dropna(subset=['Customer ID']).groupby('Customer ID')['Country'].nunique()\n",
    "\n",
    "print(f\"Rows with Registered Customer ID: {len(valid_cust):,} ({len(valid_cust)/len(df_raw)*100:.2f}%)\")\n",
    "print(f\"Unique Registered Customers:      {valid_cust.nunique():,}\")\n",
    "print(f\"Avg Lines per Registered User:    {len(valid_cust)/valid_cust.nunique():.1f}\")\n",
    "print(f\"Customer ID Range:                {int(valid_cust.min())} to {int(valid_cust.max())}\")\n",
    "print(f\"Customers in >1 Country:          {(cust_countries > 1).sum()}\")\n",
    "\n",
    "country_summary = df_raw.groupby('Country').agg(\n",
    "    Record_Count=('Invoice', 'count'),\n",
    "    Unique_Invoices=('Invoice', 'nunique'),\n",
    "    Registered_Customers=('Customer ID', 'nunique')\n",
    ").sort_values(by='Record_Count', ascending=False)\n",
    "country_summary['Record_Share (%)'] = (country_summary['Record_Count'] / len(df_raw)) * 100\n",
    "\n",
    "display(country_summary.head(10))\n",
    "\n",
    "# Plot Top 10 Non-UK Markets to reveal international demand\n",
    "intl = country_summary.drop('United Kingdom').head(10)\n",
    "fig, ax = plt.subplots(figsize=(9, 4))\n",
    "sns.barplot(x=intl['Record_Count'], y=intl.index, ax=ax, color='#4C72B0')\n",
    "ax.set_title('Top 10 International Markets by Transaction Line Count (Excluding UK)')\n",
    "ax.set_xlabel('Transaction Line Count')\n",
    "ax.set_ylabel('')\n",
    "for i, v in enumerate(intl['Record_Count']):\n",
    "    ax.text(v + 250, i, f\"{v:,}\", va='center', fontsize=9)\n",
    "ax.set_xlim(0, intl['Record_Count'].max() * 1.15)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
