      },
      "source": [
        "# Extract Year-Month\n",
        "df['YearMonth'] = df['InvoiceDate'].dt.to_period('M')\n",
        "\n",
        "# Group by month and calculate the percentage of missing customer IDs\n",
        "monthly_missing = df.groupby('YearMonth')['is_missing_cust'].agg(['count', 'sum']).rename(columns={'count': 'Total_Transactions', 'sum': 'Missing_Customer_IDs'})\n",
        "monthly_missing['Missing_Percentage'] = (monthly_missing['Missing_Customer_IDs'] / monthly_missing['Total_Transactions']) * 100\n",
        "\n",
        "display(monthly_missing)"
      ],
