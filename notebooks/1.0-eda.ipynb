        "id": "f63ebaf1",
        "outputId": "9a5d894d-5a7b-48ad-d26a-5c8be9fdf76b"
      },
      "source": [
        "df['is_missing_cust'] = df['Customer ID'].isna()\n",
        "\n",
        "country_missing = (\n",
        "    df.groupby('Country')['is_missing_cust']\n",
        "    .agg(Total_Transactions='count', Missing_Customer_IDs='sum')\n",
        "    .assign(Missing_Percentage=lambda x: (x['Missing_Customer_IDs'] / x['Total_Transactions']) * 100)\n",
        "    .sort_values('Missing_Customer_IDs', ascending=False)\n",
        ")\n",
        "\n",
        "display(country_missing.head(10))"
      ],
