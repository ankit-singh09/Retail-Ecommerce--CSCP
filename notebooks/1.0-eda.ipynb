      "source": [
        "## **Top 10 Best Selling Products**\n",
        "Let's determine which products generate the highest share of sales revenue."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 508
        },
        "id": "e142775c",
        "outputId": "416dfc2e-29fd-4b52-91af-236fb87f5404"
      },
      "source": [
        "# Top 10 products by revenue\n",
        "top_products = (\n",
        "    valid_sales.groupby(['StockCode', 'Description'])['LineTotal']\n",
        "    .sum()\n",
        "    .reset_index()\n",
        "    .sort_values(by='LineTotal', ascending=False)\n",
        "    .head(10)\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(12, 6))\n",
        "sns.barplot(data=top_products, x='LineTotal', y='Description', palette='viridis')\n",
        "plt.title('Top 10 Products by Total Revenue Generated')\n",
        "plt.xlabel('Total Revenue (£)')\n",
        "plt.ylabel('Product Description')\n",
        "plt.show()"
      ],
      "execution_count": 32,
